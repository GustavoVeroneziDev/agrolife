# ─────────────────────────────────────────────────────────────
#  Agro Life — regras globais de segurança
# ─────────────────────────────────────────────────────────────

# Desabilita listagem de diretórios
Options -Indexes

# Bloqueia acesso direto a arquivos que nunca devem ser servidos via HTTP
<FilesMatch "\.(sql|log|env|sh|bak|md|lock|json)$">
    Require all denied
</FilesMatch>

# Bloqueia acesso direto a pastas administrativas / sensíveis
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config(/|$)      - [F,L]
    RewriteRule ^migrations(/|$)  - [F,L]
    RewriteRule ^cron(/|$)        - [F,L]
    RewriteRule ^Base(/|$)        - [F,L]
</IfModule>

# Cabeçalhos de segurança HTTP (requer mod_headers)
<IfModule mod_headers.c>
    Header always set X-Frame-Options          "SAMEORIGIN"
    Header always set X-Content-Type-Options   "nosniff"
    Header always set Referrer-Policy          "strict-origin-when-cross-origin"
    Header always set Permissions-Policy       "camera=(), microphone=(), geolocation=()"
    Header always unset X-Powered-By
</IfModule>

# Cache de assets estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png             "access plus 1 year"
    ExpiresByType image/jpeg            "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 year"
    ExpiresByType image/x-icon          "access plus 1 year"
    ExpiresByType text/css              "access plus 6 months"
    ExpiresByType application/javascript "access plus 6 months"
</IfModule>

# mod_expires casa pelo Content-Type da resposta, não pela extensão do
# arquivo — sw.php responde como application/javascript e acabava
# herdando o cache de 6 meses acima, duplicando/conflitando com o
# Cache-Control "no-cache" que o próprio PHP já define (o service
# worker precisa ser sempre revalidado, senão um deploy novo demora
# a chegar pros usuários já instalados).
<FilesMatch "^(sw|manifest)\.php$">
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
</FilesMatch>
